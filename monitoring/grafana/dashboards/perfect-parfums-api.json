      "targets": [
        {
          "expr": "(sum(rate(perfect_parfums_http_requests_total{status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(perfect_parfums_http_requests_total[5m])), 0.001)) or vector(0)",
          "legendFormat": "5xx",
          "refId": "A"
        }
      ],
      "title": "Доля ошибок 5xx",
      "type": "stat",
      "description": "Доля серверных ошибок среди всех запросов. Любой стабильный рост требует проверки логов ошибок."
